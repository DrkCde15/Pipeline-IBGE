# Credenciais do PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=dados_publicos
PG_USER=postgres
PG_PASSWORD=senha_secreta

# Configurações do IBGE
IBGE_API_BASE=https://servicodados.ibge.gov.br/api/v1
IBGE_AGREGADOS_BASE=https://servicodados.ibge.gov.br/api/v3/agregados
IBGE_TIMEOUT=30

# Configurações da Receita Federal
CNPJ_API_BASE=https://receitaws.com.br/v1/cnpj
CNPJ_API_KEY=
CNPJ_RATE_LIMIT=3

# Configurações do Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=pipeline-dados-publicos

# Airflow 2 (UI local via compose — DEV ONLY, nunca produção)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# UID usado pelos containers (compose usa user: "${AIRFLOW_UID:-50000}:0").
# Fixe com o seu UID (id -u) para o Spark conseguir sobrescrever ./data.
AIRFLOW_UID=1000
